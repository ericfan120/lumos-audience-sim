# Lumos Audience Intelligence Simulator - Environment Config
# Use EITHER Anthropic OR OpenAI — Anthropic takes priority if both are set

# Option A: Anthropic (recommended — uses claude-3-5-haiku-20241022)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Option B: OpenAI (or any OpenAI-compatible endpoint)
